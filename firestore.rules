rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts: anyone can read published, only admins write
    match /posts/{postId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: can read/write own doc, admin reads all
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Chat history: users own their sessions
    match /chatHistory/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Inquiries: anyone can create, only admins read
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Subscribers: anyone can subscribe
    match /subscribers/{email} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Analytics: anyone can write events, admin reads
    match /analytics/{doc}/events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // AI Rules: admin only
    match /aiRules/{doc} {
      allow read: if true; // Server reads for chat
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      match /versions/{v} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }

    // AI News cache: server writes, admin reads
    match /aiNewsCache/{doc} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if false; // Server-side only via Admin SDK
    }
  }
}
